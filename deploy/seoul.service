[Unit]
Description=Muse2API (Seoul, concurrency 1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=4

[Service]
Type=simple
User=muse2api
Group=muse2api
WorkingDirectory=/opt/muse2api
Environment=HOME=/var/lib/muse2api
Environment=MUSE2API_HOME=/var/lib/muse2api
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/var/lib/muse2api/.env
ExecStart=/opt/muse2api/venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 18610 --root-path /muse --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/muse2api
MemoryAccounting=true
MemoryHigh=800M
MemoryMax=1000M
MemorySwapMax=512M
CPUQuota=100%
CPUWeight=25
TasksMax=384
LimitNOFILE=8192
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
